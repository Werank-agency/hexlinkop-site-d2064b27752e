import E7478a from '../components/views/E7478a.tsx';
import Ef89f4 from '../components/views/Ef89f4.tsx';
import C736a from '../components/views/C736a.tsx';

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://sellyourstufftoday.bid/#website",
      "url": "https://sellyourstufftoday.bid",
      "name": "business site",
      "description": "A site that deals with information about businesses",
      "inLanguage": "en-US"
    },
    {
      "@type": "Organization",
      "@id": "https://sellyourstufftoday.bid/#organization",
      "name": "business site",
      "url": "https://sellyourstufftoday.bid",
      "description": "A site that deals with information about businesses"
    },
    {
      "@type": "WebPage",
      "@id": "https://sellyourstufftoday.bid#webpage",
      "url": "https://sellyourstufftoday.bid",
      "name": "Business Information Hub | Business Site",
      "description": "Unlock valuable business insights on Business Site, your trusted source for comprehensive information, tips, strategies, and resources to boost your business...",
